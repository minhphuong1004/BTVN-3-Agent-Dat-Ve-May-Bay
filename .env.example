# API key used to authenticate with the LLM provider
LLM_API_KEY=your_api_key_here
# Name of the LLM model to use
LLM_MODEL=your_model_name_here
# Base URL of the LLM API endpoint (leave empty if not required)
LLM_BASE_URL=your_llm_base_url_here
# Use mock responses without consuming API quota
MOCK_MODE=true
